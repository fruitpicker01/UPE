idth=2;endArrow=block;endFill=1;fontColor=#465049;fontSize=10;fontStyle=1;labelBackgroundColor=#F4F6F3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node-pres_emp" target="node-e4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1595" y="1230"/><mxPoint x="1095" y="1230"/></Array></mxGeometry></mxCell><mxCell id="edge-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#BFC8C1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#465049;fontSize=10;fontStyle=1;labelBackgroundColor=#F4F6F3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node-e4" target="node-e5_enter"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-21" value="да / удобно" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#BFC8C1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#465049;fontSize=10;fontStyle=1;labelBackgroundColor=#F4F6F3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node-e5_enter" target="node-e5_channel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-22" value="не сейчас" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#BFC8C1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#465049;fontSize=10;fontStyle=1;labelBackgroundColor=#F4F6F3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="node-e5_enter" target="node-e6_instr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1825" y="1394"/><mxPoint x="1825" y="1394"/></Array></mxGeometry></mxCell><mxCell id="edge-23" value="мобильное приложение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#BFC8C1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#465049;fontSize=10;fontStyle=1;labelBackgroundColor=#F4F6F3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="