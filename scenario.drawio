<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" agent="Codex" version="26.0.9" compressed="false" pages="3"><diagram id="scenario-main" name="Полная схема"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2250" pageHeight="2650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="main-title" value="&lt;div style=&quot;font-size:22px;font-weight:700;&quot;&gt;Карта сценария — ЦКМ, зарплатный проект&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#6E7A73;margin-top:4px;&quot;&gt;Полная редактируемая схема из index.html · подписи переходов редактируются вместе со стрелками&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1200" height="55" as="geometry"/></mxCell><mxCell id="legend-start" value="&lt;div style=&quot;font-size:11px;font-weight:600;&quot;&gt;Вход&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F6E43;strokeColor=#1F6E43;fontColor=#FFFFFF;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;fontSize=11;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="135" height="30" as="geometry"/></mxCell><mxCell id="legend-say" value="&lt;div style=&quot;font-size:11px;font-weight:600;&quot;&gt;Реплика&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;fontSize=11;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="170" y="78" width="135" height="30" as="geometry"/></mxCell><mxCell id="legend-ask" value="&lt;div style=&quot;font-size:11px;font-weight:600;&quot;&gt;Вопрос&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;fontSize=11;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="78" width="135" height="30" as="geometry"/></mxCell><mxCell id="legend-service" value="&lt;div style=&quot;font-size:11px;font-weight:600;&quot;&gt;Служебный шаг&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E7F1;strokeColor=#5A6B8C;fontColor=#111815;strokeWidth=2;dashed=1;dashPattern=5 3;align=left;verticalAlign=middle;spacing=10;fontSize=11;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="470" y="78" width="135" height="30" as="geometry"/></mxCell><mxCell id="legend-end" value="&lt;div style=&quot;font-size:11px;font-weight:600;&quot;&gt;Завершение&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5DDD9;strokeColor=#A3342A;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;fontSize=11;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="78" width="135" height="30" as="geometry"/></mxCell><mxCell id="swim-0" value="&lt;div style=&quot;font-size:10px;font-weight:700;letter-spacing:1px;color:#6E7A73;&quot;&gt;ВХОД&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D2D9D3;dashed=1;dashPattern=2 6;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;connectable=0;" vertex="1" parent="1"><mxGeometry x="20" y="126" width="2100" height="88" as="geometry"/></mxCell><mxCell id="swim-1" value="&lt;div style=&quot;font-size:10px;font-weight:700;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 1 · ПРИВЕТСТВИЕ&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D2D9D3;dashed=1;dashPattern=2 6;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;connectable=0;" vertex="1" parent="1"><mxGeometry x="20" y="214" width="2100" height="320" as="geometry"/></mxCell><mxCell id="swim-2" value="&lt;div style=&quot;font-size:10px;font-weight:700;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 2 · ВОВЛЕЧЕНИЕ&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D2D9D3;dashed=1;dashPattern=2 6;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;connectable=0;" vertex="1" parent="1"><mxGeometry x="20" y="534" width="2100" height="548" as="geometry"/></mxCell><mxCell id="swim-3" value="&lt;div style=&quot;font-size:10px;font-weight:700;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 3 · ПРЕЗЕНТАЦИЯ&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D2D9D3;dashed=1;dashPattern=2 6;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;connectable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1082" width="2100" height="128" as="geometry"/></mxCell><mxCell id="swim-4" value="&lt;div style=&quot;font-size:10px;font-weight:700;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 4 · ПЕРЕХОД&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D2D9D3;dashed=1;dashPattern=2 6;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;connectable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1210" width="2100" height="108" as="geometry"/></mxCell><mxCell id="swim-5" value="&lt;div style=&quot;font-size:10px;font-weight:700;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 5 · ОФОРМЛЕНИЕ&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D2D9D3;dashed=1;dashPattern=2 6;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;connectable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1318" width="2100" height="956" as="geometry"/></mxCell><mxCell id="swim-6" value="&lt;div style=&quot;font-size:10px;font-weight:700;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 6 · ПРОЩАНИЕ&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D2D9D3;dashed=1;dashPattern=2 6;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;connectable=0;" vertex="1" parent="1"><mxGeometry x="20" y="2274" width="2100" height="138" as="geometry"/></mxCell><mxCell id="swim-7" value="&lt;div style=&quot;font-size:10px;font-weight:700;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 7 · ТЕХНИЧЕСКОЕ ЗАВЕРШЕНИЕ&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D2D9D3;dashed=1;dashPattern=2 6;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;connectable=0;" vertex="1" parent="1"><mxGeometry x="20" y="2412" width="2100" height="180" as="geometry"/></mxCell><mxCell id="node-start" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#EAF5EF;&quot;&gt;ВХОД&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#FFFFFF;margin-top:3px;&quot;&gt;Исходящий звонок&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F6E43;strokeColor=#1F6E43;fontColor=#FFFFFF;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Правило: Анна — виртуальный голосовой помощник Сбера. Звонок всегда исходящий. НИКОГДА не спрашивай клиента, зачем или по какому вопросу он звонит.

Строки источника: 1, 42" data-type="start" data-stage="ВХОД" data-branches="core" data-source-lines="1, 42"><mxGeometry x="970" y="164" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-e1_greet" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 1&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Приветствие&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Добрый день, {clientName}. Меня зовут Анна, Сбер.»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Добрый день, {clientName}. Меня зовут Анна, Сбер.

Правило: Этап 1 — НЕ ПРОПУСКАТЬ. Поздоровайся, представься, обозначь, по какой организации или ИП звонишь.

Строки источника: 138–139" data-type="say" data-stage="ЭТАП 1" data-branches="core" data-source-lines="138–139"><mxGeometry x="970" y="252" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e1_org" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 1&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Строка про организацию&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Звоню вам по вашему ИП.»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Звоню вам по вашему ИП. / Звоню вам по вашей организации {organizationName}.

Правило: Первый вариант — ТОЛЬКО если в {organizationName} явно указано ИП («ИП Иванов») или клиент сам сказал, что у него ИП; слова клиента приоритетнее базы. Во всех остальных случаях — второй вариант, обязательно произнося название. Название ИП в приветствии не упоминается.

Строки источника: 124–125, 140" data-type="say" data-stage="ЭТАП 1" data-branches="core" data-source-lines="124–125, 140"><mxGeometry x="970" y="352" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-e1_conv" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 1&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Удобно говорить?&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Удобно сейчас говорить?»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Удобно сейчас говорить?

Правило: Ответ «нет» здесь — не отказ от продукта, а неудобство разговора: причину не спрашивай, действуй по стоп-условию 5 (перезвон).

Строки источника: 141" data-type="ask" data-stage="ЭТАП 1" data-branches="core" data-source-lines="141"><mxGeometry x="970" y="456" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-stop5" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;1.4 п.5&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Перезвоним позже&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Хорошо, мы вам перезвоним. До свидания»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5DDD9;strokeColor=#A3342A;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Хорошо, мы вам перезвоним. До свидания

Правило: «Есть пара минут», «две минуты», «только быстро» — это согласие продолжить разговор сейчас, а не просьба перезвонить: скажи, что не задержишь, и продолжай сценарий. Ветка ниже — только когда клиент действительно просит перенести разговор. Финальная ветка: после прощания переходи к этапу 7 с кодом перезвона. Срок не назван — IVR_callback60; больше суток — CIB_IVR_Refuse; CIB_IVR_Complete здесь не используется. Код нужен для внутренней маршрутизации — клиенту дату и время не называй и не подтверждай, даже если он назвал срок сам. Если неудобно именно оформлять, а разговор продолжается — перезвон не назначай, иди в этап 6 (материалы/СМС).

Строки источника: 82" data-type="end" data-stage="1.4 п.5" data-branches="refuse" data-source-lines="82"><mxGeometry x="1570" y="456" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e2_q" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 2&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Есть сотрудники?&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«{clientName}, обратили внимание, что у вас нет зарплатного проекта…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: {clientName}, обратили внимание, что у вас нет зарплатного проекта в Сбере. Скажите, у вас есть сотрудники?

Правило: Если обращение по имени только что прозвучало в приветствии, здесь имя можно опустить. Ответ «нет» на этот вопрос — ответ по ситуации, а не отказ.

Строки источника: 144–145" data-type="ask" data-stage="ЭТАП 2" data-branches="core" data-source-lines="144–145"><mxGeometry x="970" y="572" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e2_undef" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 2&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Неопределённый ответ&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Поняла. А сотрудники у вас сейчас есть?»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Поняла. А сотрудники у вас сейчас есть?

Правило: Ответы «никак», «не выплачиваем», «зарплаты нет» — НЕ выбирай ветку сама, сначала уточни. Если клиент говорит, что деятельность не ведётся — раздел 3.2.

Строки источника: 164" data-type="ask" data-stage="ЭТАП 2" data-branches="core" data-source-lines="164"><mxGeometry x="1305" y="712" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-end_inactive" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;3.2&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Деятельность не ведётся&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Поняла вас. Тогда зарплатный проект сейчас вам не актуален.…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5DDD9;strokeColor=#A3342A;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Поняла вас. Тогда зарплатный проект сейчас вам не актуален. Если возобновите деятельность — будем рады помочь. Хорошего дня!

Правило: Бизнес приостановлен, закрывается, закрыт, лицензия сдана — для любой формы (и ИП, и ООО). НЕ перечисляй преимущества, не говори «бесплатно» и про экономию, даже кратко.

Строки источника: 236" data-type="end" data-stage="3.2" data-branches="inactive" data-source-lines="236"><mxGeometry x="1635" y="712" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e2_sez" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 2&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Работаете с самозанятыми?&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«А вы работаете с самозанятыми?»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: А вы работаете с самозанятыми?

Строки источника: 146–147" data-type="ask" data-stage="ЭТАП 2" data-branches="sez,leader,ip" data-source-lines="146–147"><mxGeometry x="625" y="712" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-e2_form" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 2&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Проверка формы бизнеса&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E7F1;strokeColor=#5A6B8C;fontColor=#111815;strokeWidth=2;dashed=1;dashPattern=5 3;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Правило: СРАЗУ снова проверь исходное значение {organizationName}, учитывая явные уточнения клиента — слова клиента приоритетнее. Никогда не определяй форму бизнеса по отсутствию сотрудников или самозанятых.

Строки источника: 149, 162" data-type="service" data-stage="ЭТАП 2" data-branches="leader,ip" data-source-lines="149, 162"><mxGeometry x="500" y="832" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-e2_askform" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 2&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;У вас ИП или ООО?&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Подскажите, у вас ИП или ООО?»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Подскажите, у вас ИП или ООО?

Правило: Если в {organizationName} нет ни «ООО», ни «ИП» и клиент не называл форму: НЕ выбирай ветку ИП и НЕ завершай разговор.

Строки источника: 160–161" data-type="ask" data-stage="ЭТАП 2" data-branches="leader,ip" data-source-lines="160–161"><mxGeometry x="130" y="832" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-end_ip" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;3.2&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;ИП без сотрудников&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Поняла вас. Зарплатный проект доступен вам бесплатно — когда…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5DDD9;strokeColor=#A3342A;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Поняла вас. Зарплатный проект доступен вам бесплатно — когда ситуация в бизнесе изменится, сможете сэкономить на комиссии за переводы физлицам. Если появятся вопросы — звоните 0321, добавочный один. Хорошего дня!

Правило: Эта фраза разрешена ТОЛЬКО для ИП без сотрудников и самозанятых (продублировано в блоке ОГРАНИЧЕНИЯ, п. 4). Для ООО без сотрудников и самозанятых ОБЯЗАТЕЛЕН вопрос про роль руководителя.

Строки источника: 235, 360" data-type="end" data-stage="3.2" data-branches="ip" data-source-lines="235, 360"><mxGeometry x="130" y="962" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e2_leader" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 2&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Вы руководитель?&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Подскажите, а вы руководитель организации?»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Подскажите, а вы руководитель организации?

Правило: Для ООО: НЕ завершай разговор, НЕ используй фразу для ИП, НЕ считай продукт неактуальным только из-за отсутствия сотрудников и самозанятых.

Строки источника: 150–157" data-type="ask" data-stage="ЭТАП 2" data-branches="leader" data-source-lines="150–157"><mxGeometry x="435" y="962" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e2_sms" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 2&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;СМС для руководителя&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Могу отправить вам СМС с описанием зарплатного проекта, чтобы вы…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Могу отправить вам СМС с описанием зарплатного проекта, чтобы вы передали руководителю. Отправить?

Правило: Не руководитель — про выплаты себе не говори. Согласие уже получено этим вопросом — второй раз про СМС не переспрашивай: сразу подтверди отправку и попрощайся (этап 6, стр. 194). При отказе вежливо заверши разговор.

Строки источника: 157" data-type="ask" data-stage="ЭТАП 2" data-branches="leader" data-source-lines="157"><mxGeometry x="130" y="1092" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-pres_leader" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 3&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Презентация «Руководителю»&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Зарплатный проект используют, чтобы выплачивать средства себе.…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Зарплатный проект используют, чтобы выплачивать средства себе. Вы сможете экономить лимит на переводы физлицам в подписке СберБизнес Прайм, получить сниженные ставки по личным кредитам и ипотеке, а также понизить ставку по бизнес-кредиту до двух процентных пунктов. Кроме того, при наличии расчётного счёта в Сбере вы получите вознаграждение за рекомендацию зарплатного проекта партнёрам. Хотели бы подключить? Это бесплатно.

Правило: ТОЛЬКО руководителю ООО без сотрудников и самозанятых. Для ИП эта презентация запрещена — ИП не выплачивает себе зарплату.

Строки источника: 175–176" data-type="say" data-stage="ЭТАП 3" data-branches="leader" data-source-lines="175–176"><mxGeometry x="435" y="1120" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-pres_sez" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 3&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Презентация «Самозанятые»&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«С зарплатным проектом расчеты с самозанятыми станут проще. Мы сами…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: С зарплатным проектом расчеты с самозанятыми станут проще. Мы сами проверим, активен ли их статус, автоматически сформируем чеки и, главное, переведем деньги на карты Сбера без комиссии. Хотели бы подключить? Это бесплатно.

Правило: Ветка выбирается, когда сотрудников нет, но есть самозанятые.

Строки источника: 172–173" data-type="say" data-stage="ЭТАП 3" data-branches="sez" data-source-lines="172–173"><mxGeometry x="970" y="1120" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-pres_emp" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 3&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Презентация «Есть сотрудники»&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Зарплатный проект позволит вам делать зарплатные выплаты…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Зарплатный проект позволит вам делать зарплатные выплаты сотрудникам и переводы самозанятым на карты Сбера без комиссии, а также снизить ставку по кредитам для бизнеса до двух процентных пунктов. Кроме того, при наличии расчётного счёта в Сбере вы сможете получать вознаграждение за рекомендацию нашего проекта партнёрам. / Хотели бы подключить? Это бесплатно.

Правило: Ветка выбирается, даже если выплаты сейчас временно не идут.

Строки источника: 168–170" data-type="say" data-stage="ЭТАП 3" data-branches="emp" data-source-lines="168–170"><mxGeometry x="1470" y="1120" width="250" height="92" as="geometry"/></mxCell><mxCell id="node-e4" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 4&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Переход к оформлению&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E7F1;strokeColor=#5A6B8C;fontColor=#111815;strokeWidth=2;dashed=1;dashPattern=5 3;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Правило: Служебный шаг, без отдельной фразы. Презентации уже заканчиваются вопросом «Хотели бы подключить?». После явного согласия не спрашивай о готовности повторно, не повторяй презентацию и не говори заново «давайте подключим» — сразу первая фраза этапа 5.

Строки источника: 180–181" data-type="service" data-stage="ЭТАП 4" data-branches="core" data-source-lines="180–181"><mxGeometry x="970" y="1248" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-e5_enter" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 5&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Сможете зайти сейчас?&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Для подключения вам нужно зайти в личный кабинет СберБизнес.…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Для подключения вам нужно зайти в личный кабинет СберБизнес. Подскажите, сможете сейчас зайти?

Строки источника: 184" data-type="ask" data-stage="ЭТАП 5" data-branches="core" data-source-lines="184"><mxGeometry x="970" y="1356" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e5_channel" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 5&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Приложение или браузер?&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Как вам будет удобно зайти через мобильное приложение или через…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Как вам будет удобно зайти через мобильное приложение или через браузер?

Правило: В обеих ветках: не предлагай отправить СМС, когда клиент готов оформлять сейчас.

Строки источника: 185–187" data-type="ask" data-stage="ЭТАП 5" data-branches="app,browser" data-source-lines="185–187"><mxGeometry x="970" y="1464" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-a1" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;МП 1/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Открыть приложение&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Откройте приложение СберБизнес, как откроете, скажите?»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Откройте приложение СберБизнес, как откроете, скажите?

Строки источника: 190" data-type="ask" data-stage="МП 1/7" data-branches="app" data-source-lines="190"><mxGeometry x="620" y="1590" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-a2" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;МП 2/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Экран Продукты&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Перейдите на экран Продукты.»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Перейдите на экран Продукты.

Строки источника: 191" data-type="ask" data-stage="МП 2/7" data-branches="app" data-source-lines="191"><mxGeometry x="620" y="1690" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-a3" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;МП 3/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Вкладка Все продукты&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Выберите вкладку Все продукты и найдите зарплатный проект.…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Выберите вкладку Все продукты и найдите зарплатный проект. Выбрали?

Строки источника: 192" data-type="ask" data-stage="МП 3/7" data-branches="app" data-source-lines="192"><mxGeometry x="620" y="1790" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-a4" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;МП 4/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Нажать Подключить&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Нажмите Подключить. Получилось?»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Нажмите Подключить. Получилось?

Строки источника: 193" data-type="ask" data-stage="МП 4/7" data-branches="app" data-source-lines="193"><mxGeometry x="620" y="1890" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-a5" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;МП 5/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Заявление о присоединении&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Далее заполните заявление о присоединении. Укажите счёт…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Далее заполните заявление о присоединении. Укажите счёт списания, контактное лицо и контактный телефон. Сообщите, как всё укажете.

Правило: Это единственный перечень данных, который можно называть. «Список документов» не перечисляй и не обещай — его в промпте нет.

Строки источника: 194" data-type="ask" data-stage="МП 5/7" data-branches="app" data-source-lines="194"><mxGeometry x="620" y="1990" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-a6" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;МП 6/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Продолжить&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Нажмите Продолжить»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Нажмите Продолжить

Правило: Следующий шаг начинается словами «Когда клиент нажал “Продолжить”» — значит, здесь нужно дождаться клиента. В самом промпте это единственный шаг навигации без пометки «— Жди ответ»; остальные 13 шагов её имеют.

Строки источника: 195" data-type="say" data-stage="МП 6/7" data-branches="app" data-source-lines="195"><mxGeometry x="620" y="2090" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-a7" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;МП 7/7&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Подтверждение СМС-кодом&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Подтвердите заявление с помощью СМС-кода. После обработки заявки…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Подтвердите заявление с помощью СМС-кода. После обработки заявки зарплатный проект появится во вкладке Подключено. Чтобы создать новые выплаты или посмотреть уже существующие, нажмите «Перейти к выплатам».

Строки источника: 196" data-type="say" data-stage="МП 7/7" data-branches="app" data-source-lines="196"><mxGeometry x="620" y="2190" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-b1" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;БР 1/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Войти через браузер&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Тогда войдите в личный кабинет СберБизнес через браузер.»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Тогда войдите в личный кабинет СберБизнес через браузер.

Строки источника: 199" data-type="say" data-stage="БР 1/7" data-branches="browser" data-source-lines="199"><mxGeometry x="1305" y="1590" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-b2" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;БР 2/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Меню → Зарплатный проект&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«В левом горизонтальном меню выберите «Зарплатный проект» и…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: В левом горизонтальном меню выберите «Зарплатный проект» и нажмите «Оформить заявку».

Строки источника: 200" data-type="say" data-stage="БР 2/7" data-branches="browser" data-source-lines="200"><mxGeometry x="1305" y="1690" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-b3" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;БР 3/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Форма заявления&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Откроется форма для заполнения заявления. В поле Счёт укажите из…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Откроется форма для заполнения заявления. В поле Счёт укажите из списка номер расчётного счёта. В поле Контактное лицо укажите фамилию, имя и отчество, а также телефон контактного лица. Добавьте контактное лицо вручную.

Правило: «Фамилия, имя и отчество» — произносится словами, не по буквам.

Строки источника: 201" data-type="say" data-stage="БР 3/7" data-branches="browser" data-source-lines="201"><mxGeometry x="1305" y="1790" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-b4" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;БР 4/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Создать и подписать&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«После заполнения полей нажмите Создать. Произойдёт переход к…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: После заполнения полей нажмите Создать. Произойдёт переход к подписанию заявки. При необходимости нажмите Изменить или Удалить заявление. Для направления в банк нажмите Подписать и отправить.

Строки источника: 202" data-type="say" data-stage="БР 4/7" data-branches="browser" data-source-lines="202"><mxGeometry x="1305" y="1890" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-b5" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;БР 5/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Подписание: СМС или токен&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Подпишите заявление в зависимости от типа защиты - СМС или токен.…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Подпишите заявление в зависимости от типа защиты - СМС или токен. Сразу после подписания заявление отправится в банк. Во время обработки нажмите Проверить подпись, чтобы проверить, кем подписано заявление.

Строки источника: 203" data-type="say" data-stage="БР 5/7" data-branches="browser" data-source-lines="203"><mxGeometry x="1305" y="1990" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-b6" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;БР 6/7&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Сообщение об исполнении&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«После обработки заявления внизу появится сообщение об исполнении.…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: После обработки заявления внизу появится сообщение об исполнении. При необходимости скачайте заявление, нажав справа на Скачать печатную форму.

Строки источника: 204" data-type="say" data-stage="БР 6/7" data-branches="browser" data-source-lines="204"><mxGeometry x="1305" y="2090" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-b7" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;БР 7/7&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Выпуск карт&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«После регистрации договора можете выпустить карты и делать выплаты.»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E43;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: После регистрации договора можете выпустить карты и делать выплаты.

Строки источника: 205" data-type="say" data-stage="БР 7/7" data-branches="browser" data-source-lines="205"><mxGeometry x="1305" y="2190" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e6_done" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 6&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;После оформления&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«В течение недели с номера 0321 с вами свяжется менеджер, расскажет,…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5DDD9;strokeColor=#A3342A;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: В течение недели с номера 0321 с вами свяжется менеджер, расскажет, как им пользоваться, и при необходимости ответит на вопросы. / Ещё вы всегда можете обратиться в чат СберБизнес или на номер 0321, если вопросы возникнут раньше. Всего доброго!

Правило: Прощание обязательно во всех сценариях, не только при отказе. Это этап 6 — обычная реплика с текстом. Функцию dialog_end в ней не вызывай: она вызывается отдельно, на этапе 7.

Строки источника: 208–210" data-type="end" data-stage="ЭТАП 6" data-branches="core" data-source-lines="208–210"><mxGeometry x="970" y="2312" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e6_instr" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 6&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;СМС с ИНСТРУКЦИЕЙ&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Могу отправить вам СМС со ссылкой на инструкцию по подключению…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Могу отправить вам СМС со ссылкой на инструкцию по подключению сервиса после нашего разговора. Если появятся вопросы – звоните 0321, добавочный один, вам обязательно помогут. Подскажите, удобно ли так будет?

Правило: Когда клиенту неудобно оформить на звонке или он хочет оформить самостоятельно.

Строки источника: 212–213" data-type="ask" data-stage="ЭТАП 6" data-branches="refuse" data-source-lines="212–213"><mxGeometry x="1520" y="1356" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e6_desc" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 6&lt;span style=&quot;float:right;color:#8A5A00;font-size:10px;&quot;&gt;Ⅱ&amp;nbsp;ЖДАТЬ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;СМС с ОПИСАНИЕМ&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Могу отправить вам СМС со ссылкой на описание зарплатного проекта…»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6EBD4;strokeColor=#8A5A00;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Могу отправить вам СМС со ссылкой на описание зарплатного проекта после нашего разговора. Если появятся вопросы – звоните 0321, добавочный один, вам обязательно помогут. Подскажите, удобно ли так будет?

Правило: Предлагается, когда клиент хочет почитать или подумать, но сам ещё не попросил прислать информацию. Входит из любой точки разговора — отдельной стрелки нет именно поэтому. Если клиент попросил сам, согласие не переспрашивай: сразу подтверди отправку (см. «Согласие на СМС»).

Строки источника: 214–215" data-type="ask" data-stage="ЭТАП 6" data-branches="leader,refuse" data-source-lines="214–215"><mxGeometry x="1890" y="1356" width="250" height="76" as="geometry"/></mxCell><mxCell id="entry-e6_desc" value="&lt;div style=&quot;font-size:9px;color:#6E7A73;text-align:right;&quot;&gt;клиент сомневается или просит почитать&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1755" y="1372" width="120" height="44" as="geometry"/></mxCell><mxCell id="entry-edge-e6_desc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=3 3;strokeColor=#BFC8C1;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="entry-e6_desc" target="node-e6_desc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="node-e6_agree" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 6&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Согласие на СМС&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:11px;font-style:italic;color:#465049;margin-top:4px;&quot;&gt;«Хорошо, отправлю после нашего разговора. Всего доброго!»&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5DDD9;strokeColor=#A3342A;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Реплика: Хорошо, отправлю после нашего разговора. Всего доброго! / Хорошо, отправлю вам СМС после нашего разговора. Если появятся вопросы — звоните 0321, добавочный один. Всего доброго!

Правило: Вторая формулировка — когда клиент САМ попросил прислать инструкцию или описание: согласие не переспрашивай. Правила СМС: это единственные допустимые упоминания СМС; отправка только на номер звонка и только после просьбы или согласия; говори в будущем времени («отправлю после разговора»), не говори «СМС отправлена».

Строки источника: 216–217" data-type="end" data-stage="ЭТАП 6" data-branches="refuse" data-source-lines="216–217"><mxGeometry x="1520" y="1492" width="250" height="76" as="geometry"/></mxCell><mxCell id="node-e6_bye" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 6&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Отказ от СМС — прощание&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5DDD9;strokeColor=#A3342A;fontColor=#111815;strokeWidth=2;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Правило: Если клиент отказался от СМС — вежливо попрощайся без отправки обычной фразой. Это этап 6; следующей репликой — этап 7. Прощание («До свидания!»). Слова клиента «спасибо» или «до свидания» не заменяют прощание с твоей стороны.

Строки источника: 217, 35" data-type="end" data-stage="ЭТАП 6" data-branches="refuse" data-source-lines="217, 35"><mxGeometry x="1810" y="1492" width="250" height="64" as="geometry"/></mxCell><mxCell id="node-e7" value="&lt;div style=&quot;font-family:Segoe UI,Arial,sans-serif;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:9px;letter-spacing:1px;color:#6E7A73;&quot;&gt;ЭТАП 7&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#111815;margin-top:3px;&quot;&gt;Техническое завершение&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E7F1;strokeColor=#5A6B8C;fontColor=#111815;strokeWidth=2;dashed=1;dashPattern=5 3;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1" tooltip="Правило: Сюда приходят ВСЕ терминальные ветки — отдельными стрелками не показано. Прощание (этап 6) и вызов функции никогда не идут в одной реплике: сначала обычная реплика с прощанием, затем следующей репликой — пустая реплика-заглушка с вызовом dialog_end. Прощание клиента для перехода не требуется: в ветках молчания, автоответчика, отказа и перезвона клиент не прощается вовсе. Если клиент попрощался в ответ («до свидания», «спасибо, до свидания») — не отвечай текстом вообще, сразу вызывай функцию. Ответное «До свидания!» здесь — ошибка: разговор зависнет. Код исхода определяется до прощания, по причине завершения, и на этапе 7 не пересматривается: пообещала СМС → SEND_SMS_*; отказ или продукт не подходит → CIB_IVR_Refuse; автоответчик → CIB_IVR_Autoanswer_Recall; перезвон → код интервала (срок больше суток → CIB_IVR_Refuse); оформление завершено → CIB_IVR_Complete. Ответные «спасибо» и «до свидания» код не меняют.

Строки источника: 54, 56–59, 224–225" data-type="service" data-stage="ЭТАП 7" data-branches="core" data-source-lines="54, 56–59, 224–225"><mxGeometry x="970" y="2450" width="250" height="64" as="geometry"/></mxCell><mxCell id="entry-e7" value="&lt;div style=&quot;font-size:9px;color:#6E7A73;text-align:right;&quot;&gt;true&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="835" y="2460" width="120" height="44" as="geometry"/></mxCell><mxCell id="entry-edge-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=3 3;strokeColor=#BFC8C1;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="entry-e7" target="node-e7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#BFC8C1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#465049;fontSize=10;fontStyle=1;labelBackgroundColor=#F4F6F3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node-start" target="node-e1_greet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#BFC8C1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#465049;fontSize=10;fontStyle=1;labelBackgroundColor=#F4F6F3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node-e1_greet" target="node-e1_org"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#BFC8C1;strokeWidth=2;endArrow=block;endFill=1;fontColor=#465049;fontSize=10;fontStyle=1;labelBackgroundColor=#F4F6F3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node-e